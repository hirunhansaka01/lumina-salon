# ── Supabase (Project Settings → API) ─────────────────────────────
# Never exposed to the browser. Server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Sessions ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Studio configuration ─────────────────────────────────────────
SALON_TIMEZONE=America/Chicago
SALON_NAME=Lumina Salon

# First admin account created by scripts/setup-db.js (optional)
SETUP_ADMIN_NAME=Elena Vance
SETUP_ADMIN_EMAIL=elena@luminasalon.com
SETUP_ADMIN_PASSWORD=LuminaStudio2026!
PORT=3000

# ── Email (Gmail SMTP) ────────────────────────────────────────────
# Create an App Password at myaccount.google.com → Security → 2-Step
# Verification → App passwords. Never commit real values: set these in
# Vercel → Project → Settings → Environment Variables.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=your-address@gmail.com
MAIL_FROM_NAME=Lumina Salon
# Where internal "something happened" alerts go (defaults to SMTP_USER)
NOTIFY_EMAIL=your-address@gmail.com

# Absolute URL used in email links and unsubscribe text
PUBLIC_SITE_URL=https://salonlumina.vercel.app
