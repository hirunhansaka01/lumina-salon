# ── Supabase (Project Settings → API) ─────────────────────────────
# Never exposed to the browser. Server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Sessions ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Studio configuration ─────────────────────────────────────────
SALON_TIMEZONE=America/Chicago
SALON_NAME=Lumina Salon

# First admin account created by scripts/setup-db.js (optional)
SETUP_ADMIN_NAME=Elena Vance
SETUP_ADMIN_EMAIL=elena@luminasalon.com
SETUP_ADMIN_PASSWORD=LuminaStudio2026!
PORT=3000
